# Canoe -> SharePoint sync -- configuration keys.
#
# This file is a TEMPLATE listing every configuration value. It contains no real
# values and is safe to commit. On the App Server the real values live in the macOS
# Keychain (written by setup.py) and are exported into the environment by run_sync.sh;
# you do NOT need a real .env there. This file exists so a new install can see exactly
# what must be provided.

# --- Microsoft Graph / SharePoint (app-only certificate auth) ---
GRAPH_TENANT_ID=            # Entra ID (Azure AD) tenant id (GUID)
GRAPH_CLIENT_ID=            # App registration (application/client) id (GUID)
GRAPH_CERT_THUMBPRINT=      # Certificate thumbprint (hex, no spaces)
GRAPH_CERT_KEY_PATH=        # Absolute path to the certificate PRIVATE KEY file (PEM)
SP_HOSTNAME=               # e.g. wakerobinco.sharepoint.com
SP_SITE_PATH=              # e.g. /sites/Investment
SP_LIBRARY=                # Document library (drive) name, e.g. Documents
SP_ROOT_FOLDER=            # Folder within the library to write under, e.g. Canoe

# --- Canoe API credentials ---
CANOE_CLIENT_ID=
CANOE_CLIENT_SECRET=
CANOE_USERNAME=            # optional fallback auth
CANOE_PASSWORD=            # optional fallback auth
CANOE_ORGANIZATION_ID=     # only if the login has access to multiple orgs

# --- Runtime (optional; sensible defaults if unset) ---
CANOE_MANIFEST_PATH=       # default: <repo>/.state/manifest.json
CANOE_LOG_DIR=             # default: <repo>/logs
